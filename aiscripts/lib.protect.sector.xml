<?xml version="1.0" encoding="utf-8"?>
<aiscript name="lib.protect.sector" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="aiscripts.xsd" version="116">
  <interrupts>
    <library>
      <actions name="ProtectSectorCheckAndSignalForDamage">
        <set_value name="$isAttackingNow" exact="@$target != null and $target.exists and not $target.iswreck and $target.isoperational" />
        <!-- XS (drones) have no thresholds and are never signalled -->
        <set_value name="$shipClass"
          exact="if $shipForDamageCheck.isclass.ship_xl then 'ship_xl' else (if $shipForDamageCheck.isclass.ship_l then 'ship_l' else (if $shipForDamageCheck.isclass.ship_m then 'ship_m' else (if $shipForDamageCheck.isclass.ship_s then 'ship_s' else null)))" />
        <set_value name="$stateId" exact="if $isAttackingNow then 'attack' else 'idle'" />
        <set_value name="$damageThreshold"
          exact="if $shipClass != null then @player.entity.$ProtectSectorConfig.{'$hull_%s_%s_%s'.[$shipClass, $stateId, (@$receivedDamageSensitivity)i]} else null" />
        <set_value name="$shipIsDamaged" exact="false" />
        <do_if value="$damageThreshold != null and $shipForDamageCheck.hullpercentage lt $damageThreshold">
          <debug_text text="'PS1|%s|%s|%s|%s|damaged|ship=%s|hull=%s|limit=%s|state=%s|sens=%s|order=%s'.[player.age, @this.assignedcontrolled.debugname, @this.assignedcontrolled.class, @this.assignedcontrolled.sector.debugname, $shipForDamageCheck.debugname, $shipForDamageCheck.hullpercentage, $damageThreshold, $stateId, @$receivedDamageSensitivity, @$shipForDamageCheck.order.id]"
            chance="@$debugChance" />
          <set_value name="$shipForDamageCheck.pilot.$playerOwnedWorkaroundForRestock" exact="player.age" />
          <set_value name="$shipIsDamaged" exact="true" />
          <signal_objects object="$shipForDamageCheck" param="'resupply'" param2="[$shipForDamageCheck.hullpercentage lt 100]" param3="@$traceChance" delay="100ms" />
        </do_if>
        <remove_value name="$isAttackingNow" />
        <remove_value name="$shipClass" />
        <remove_value name="$stateId" />
        <remove_value name="$damageThreshold" />
      </actions>
      <actions name="PlayerShipsRestockWorkaround">
        <do_if value="(@$resupplystations_interrupt.count le 0) and not @$onlyuseresupplierships and this.isplayerowned and (player.age - @this.$playerOwnedWorkaroundForRestock) le 10s">
          <set_value name="$blacklistGroup" exact="blacklistgroup.military" />
          <find_station name="$resupplyStationsByWorkaround" canequipclass="this.assignedcontrolled.class" canbuildclass="$buildclass_interrupt" canbuildships="$buildclass_interrupt != null" canbuildfor="this.owner" hascontrolentity="controlpost.shiptrader" space="player.galaxy" knownto="faction.player" multiple="true" append="true" sortbydistanceto="this.assignedcontrolled" sortdescending="false">
            <match_use_blacklist group="$blacklistGroup" type="blacklisttype.objectactivity" object="this.assignedcontrolled" />
            <match_use_blacklist group="$blacklistGroup" type="blacklisttype.sectoractivity" object="this.assignedcontrolled" />
            <match_use_blacklist group="$blacklistGroup" type="blacklisttype.sectortravel" object="this.assignedcontrolled" />
            <match_relation_to object="this.assignedcontrolled" relation="enemy" comparison="not" />
          </find_station>
          <set_value name="$psRestockFound" exact="$resupplyStationsByWorkaround.count" />
          <do_all exact="$resupplyStationsByWorkaround.count" counter="$counterOfResupplyStationsByWorkaround" reverse="true">
            <do_if value="this.assignedcontrolled.gatedistance.{$resupplyStationsByWorkaround.{$counterOfResupplyStationsByWorkaround}}.{$blacklistGroup}.{this.assignedcontrolled} lt 0">
              <remove_value name="$resupplyStationsByWorkaround.{$counterOfResupplyStationsByWorkaround}" />
            </do_if>
          </do_all>
          <debug_text text="'PS1|%s|%s|%s|%s|restock|found=%s|kept=%s|first=%s'.[player.age, @this.assignedcontrolled.debugname, @this.assignedcontrolled.class, @this.assignedcontrolled.sector.debugname, $psRestockFound, $resupplyStationsByWorkaround.count, @$resupplyStationsByWorkaround.{1}.debugname]"
            chance="if @player.entity.$ProtectSectorConfig.$debugLevel == 'trace' then 100 else 0" />
          <remove_value name="$psRestockFound" />
          <do_if value="$resupplyStationsByWorkaround.count gt 0">
            <set_value name="$resupplystations_interrupt" exact="$resupplyStationsByWorkaround" />
          </do_if>
          <remove_value name="$resupplyStationsByWorkaround" />
          <remove_value name="$blacklistGroup" />
        </do_if>
      </actions>
    </library>
  </interrupts>
</aiscript>
